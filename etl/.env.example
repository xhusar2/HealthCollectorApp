# API (your public or local Health Collector API)
HEALTH_API_URL=http://127.0.0.1:6644

# Users to sync (JSON array). Alternatively set HEALTH_USERS_FILE to path to users.json
# HEALTH_USERS=[{"username":"u1","password":"p1"}]
HEALTH_USERS_FILE=./users.json

# InfluxDB 2.x (after running docker-compose.monitoring.yml, get token from Influx UI or set below)
INFLUX_URL=http://127.0.0.1:8086
INFLUX_TOKEN=your-influx-admin-token
INFLUX_ORG=family
INFLUX_BUCKET=health
